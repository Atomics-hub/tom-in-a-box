{
  "name": "tom-in-a-box",
  "version": "0.1.0",
  "description": "AI-orchestrated source-code security audit CLI for solo vulnerability researchers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "bin": {
    "tib": "./src/cli.ts"
  },
  "files": [
    "src",
    "prompts",
    "benchmarks",
    "docs",
    "examples",
    "scripts",
    "tests",
    "README.md",
    "SECURITY.md",
    "LIMITATIONS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "bun.lock",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "bench:smoke": "bun run src/cli.ts bench benchmarks --offline",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --compile --outfile ./dist/tib",
    "public:audit": "bun run scripts/publication-audit.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "security",
    "bug-bounty",
    "static-analysis",
    "vulnerability-research",
    "ai"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "smol-toml": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
